<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>JNPF.Codegen.HostDemo</RootNamespace>
    <AssemblyName>JNPF.Codegen.HostDemo</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\backend\framework\JNPF\JNPF.csproj" />
    <ProjectReference Include="..\..\backend\framework\JNPF.Extras.DatabaseAccessor.SqlSugar\JNPF.Extras.DatabaseAccessor.SqlSugar.csproj" />
    <ProjectReference Include="..\..\backend\modularity\common\JNPF.Common\JNPF.Common.csproj" />
    <ProjectReference Include="..\..\backend\modularity\common\JNPF.Common.Core\JNPF.Common.Core.csproj" />
    <ProjectReference Include="..\..\backend\modularity\common\JNPF.Common.CodeGen\JNPF.Common.CodeGen.csproj" />
    <ProjectReference Include="..\..\backend\modularity\system\JNPF.Systems.Interfaces\JNPF.Systems.Interfaces.csproj" />
    <ProjectReference Include="..\..\backend\modularity\system\JNPF.Systems\JNPF.Systems.csproj" />
    <ProjectReference Include="..\..\backend\modularity\workflow\JNPF.WorkFlow.Entitys\JNPF.WorkFlow.Entitys.csproj" />
    <ProjectReference Include="..\..\backend\modularity\engine\JNPF.Engine.Entity\JNPF.Engine.Entity.csproj" />
    <ProjectReference Include="..\..\backend\modularity\engine\JNPF.VisualDev.Engine\JNPF.VisualDev.Engine.csproj" />
    <ProjectReference Include="..\..\backend\modularity\visualdev\JNPF.VisualDev.Interfaces\JNPF.VisualDev.Interfaces.csproj" />
  </ItemGroup>
  <!-- SDK 默认编译 Modules/Generated/**/*.cs；排除 sandbox 残留 obj/bin -->
  <ItemGroup>
    <Compile Remove="Modules\Generated\obj\**" />
    <Compile Remove="Modules\Generated\bin\**" />
    <None Remove="Modules\Generated\obj\**" />
    <None Remove="Modules\Generated\bin\**" />
  </ItemGroup>
</Project>
