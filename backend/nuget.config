<?xml version="1.0" encoding="utf-8"?>
<!-- 国内 NuGet 镜像源配置 -->
<configuration>
  <packageSources>
    <clear />
    <add key="huaweicloud" value="https://repo.huaweicloud.com/repository/nuget/v3/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
