# =============================================================================
# JNPF V5.2 API - Production Dockerfile
# =============================================================================
# Build context: ./backend
# docker build -f application/JNPF.API.Entry/Dockerfile.production -t jnpf-api:production .
# =============================================================================

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
WORKDIR /app
EXPOSE 80
EXPOSE 443

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY . .
RUN dotnet build "application/JNPF.API.Entry/JNPF.API.Entry.csproj" -c Release -o /app/build

FROM build AS publish
RUN dotnet publish "application/JNPF.API.Entry/JNPF.API.Entry.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .

ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_URLS=http://+:80

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD curl -sf http://localhost:80/health || exit 1

ENTRYPOINT ["dotnet", "JNPF.API.Entry.dll"]
