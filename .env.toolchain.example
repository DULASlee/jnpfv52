# Copy to repo root as `.env.toolchain` (optional, gitignored) or set in system/user env.
# Used by episodic-memory summarization only — search/index works without these.

# --- episodic-memory (optional summarization) ---
# EPISODIC_MEMORY_API_MODEL=haiku
# EPISODIC_MEMORY_API_MODEL_FALLBACK=sonnet
# EPISODIC_MEMORY_API_BASE_URL=https://api.anthropic.com
# EPISODIC_MEMORY_API_TOKEN=
# EPISODIC_MEMORY_API_TIMEOUT_MS=120000

# Override per-repo project filter (default: .cursor/toolchain.manifest.json)
# EPISODIC_PROJECT_ID=D--JNPF-v52
# TOOLCHAIN_PROJECT_SLUG=JNPF-v52

# Override CLI path if plugin not in default cache location
# EPISODIC_MEMORY_CLI=C:\Users\you\.claude\plugins\cache\superpowers-marketplace\episodic-memory\1.4.1\cli\episodic-memory.js
