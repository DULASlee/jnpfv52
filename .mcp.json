{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": "0"
      }
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest"
      ]
    },
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant"
      ],
      "disabled": true
    },
    "sequential-thinking": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--node-options=--no-warnings",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "interactive-feedback-mcp": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "--directory",
        "D:/cursortools/interactive-feedback-mcp",
        "run",
        "server.py"
      ]
    }
  }
}