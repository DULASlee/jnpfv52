# 开发环境配置（模板 — 真实密钥移至 .env.local）
VITE_APP_ENV = 'development'

VITE_PROXY = "http://localhost:5002"

#接口地址
VITE_APP_API= /dev

#页面基础路径
VITE_APP_BASE= /DataV/

# 加密密钥（占位 — 真实密钥在 .env.local，已 gitignored）
# 生成方式: AesUtil.genAesKey() / DesUtil.genDesKey()
VITE_AES_KEY=__CHANGE_ME__
VITE_DES_KEY=__CHANGE_ME__