# Claude Code settings — 区分团队共享与个人本地
# settings.json = 团队共享 hook 注册（无密钥，入版本控制）
# settings.local.json = 个人覆盖（含 token / 本地路径，保持忽略）
.claude/settings.local.json
.claude/projects/
.claude/*.log
.claude/hooks/_test-*

# Local / temp
.specstory/
*.log
*.bak
h5-*.png
backend-run.*
pc-dev.*
ds-dev.*
smoke-test-*.png
stats.html
stats.json

# Tool artifacts
.playwright-mcp/
.serena/memories/
# DB directory - track SQL scripts, ignore backups
DB/*.bak
DB/*.BAK

# Claude Code session data (accidentally committed in Sprint 1)
backend/.claude/
DB/*
DB/

# Runtime storage (AI pipeline deliverables, attachments, generated artifacts)
FileStorage/

# Pipeline workspace generated output (per-pipeline id dirs, runtime)
workspace/generated/[0-9]*/

# Python bytecode cache (recursive — covers scripts/ and scripts/lib/)
**/__pycache__/
*.pyc

# Backup files with date/version suffix (e.g. CLAUDE.md.bak.20260707)
*.bak.*
*.bak-*

# E2E / debug runner transient state
scripts/.e2e-state.json
scripts/.events-*.txt
scripts/.jnpf-*.json
scripts/*-pid.txt

# Playwright / vitest runner output
test-output/
test-results/

# Analysis artifacts (regenerable)
ureport2-analysis/

# Serena LSP tool cache (never commit)
jnpf-web-vue3/.serena/

# Harness Quarantine — Phase 0.5 (evidence tracked, backups ignored)
# Policy: Quarantine MUST NOT be part of authoritative or automatic Harness Resolution.
# Evidence (README/MANIFEST/migration records) IS tracked; runtime backups/binaries are NOT.
.ai/quarantine/backups/
.superpowers/


# Runtime evidence output (regenerable — never commit)
# Root evidence/ holds harness run artifacts (PHASE0.5-*.json, P2-*.json); regenerated per run.
# NOTE: .claude/evidence/ is NOT ignored — it stores audit conclusions (backend-code-audit/, arch-scan/).
/evidence/

# OpenCode session runtime state — state.json / .lock / claim-*.json (429 files cleaned 2026-09-01)
.opencode/goals/state.json.sessions/

# Claude Code session cache / transient runner output
# NOTE: .session-summary-*.md IS tracked (session digests); only tmp/last caches are ignored.
.claude/.session-summary-*.tmp
.claude/.session-summary-*.last
.claude/evidence/current-test-run.txt

# Git merge / rebase / patch leftovers
*.orig
*.rej

# ---------------------------------------------------------------------------
# 过程证据 / 运行时分析产物（2026-09-01 复查补充）
# 原则: 机器可再生的分析/会话产物一律忽略; 仅保留明确的人工审计结论
# ---------------------------------------------------------------------------

# 代码分析产物 analysis/ — callgraph/diagnostics/summary 等机器生成 JSON (2×81MB)
# 保留分析脚本 (.cjs/.ps1) 以便复现, 仅忽略数据产物
analysis/**/*.json
analysis/**/*.status

# OpenCode 编辑器运行时 (state.json.sessions / state.json.lock / node_modules)
.opencode/

# Claude Code 会话过程证据 — 仅保留审计结论, 其余运行时产物(verify-*.json / 截图 / summary)忽略
.claude/evidence/**
!.claude/evidence/backend-code-audit/
!.claude/evidence/backend-code-audit/**
!.claude/evidence/arch-scan/
!.claude/evidence/arch-scan/**
