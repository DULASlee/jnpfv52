{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": "powershell -NoProfile -NonInteractive -WindowStyle Hidden -Command \"& node .cursor/hooks/session-archive-stop.mjs\"",
        "timeout": 20
      },
      {
        "command": "powershell -NoProfile -NonInteractive -WindowStyle Hidden -Command \"& node .cursor/hooks/archive-banner-stop.mjs\"",
        "timeout": 10
      },
      {
        "command": "powershell -NoProfile -NonInteractive -WindowStyle Hidden -Command \"& node .cursor/hooks/guard-pillar-stop.mjs\"",
        "timeout": 10
      }
    ],
    "sessionEnd": [
      {
        "command": "powershell -NoProfile -NonInteractive -WindowStyle Hidden -Command \"& node .cursor/hooks/session-end.mjs\"",
        "timeout": 30
      }
    ],
    "preToolUse": [
      {
        "command": "powershell -NoProfile -NonInteractive -WindowStyle Hidden -Command \"& node .cursor/hooks/guard-adf-write.mjs\"",
        "matcher": "Write|StrReplace|EditNotebook",
        "failClosed": false
      },
      {
        "command": "powershell -NoProfile -NonInteractive -WindowStyle Hidden -Command \"& node .cursor/hooks/guard-placeholder.mjs\"",
        "matcher": "Write|StrReplace|EditNotebook",
        "failClosed": false
      }
    ]
  }
}
