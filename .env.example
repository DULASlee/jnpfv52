# =============================================================================
# JNPF V5.2 Multi-Environment Configuration Template
# =============================================================================
# Usage:
#   - Copy to .env.development, .env.staging, or .env.production
#   - Never commit actual .env files to version control
#   - Use .env.local for machine-specific overrides (already gitignored)
# =============================================================================

# -----------------------------------------------------------------------------
# ENVIRONMENT IDENTIFICATION
# -----------------------------------------------------------------------------
# Options: development | staging | production
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# SQL Server connection (used by ConnectionStrings.json template)
DB_HOST=localhost
DB_PORT=1433
DB_NAME=jnpf_v52_dev
DB_USER=sa
DB_PASSWORD=<CHANGE_ME>
DB_TYPE=4

# Multi-tenant database (optional)
# TENANT_DB_HOST=localhost
# TENANT_DB_PORT=1433
# TENANT_DB_NAME=jnpf_v52_tenant
# TENANT_DB_USER=sa
# TENANT_DB_PASSWORD=<CHANGE_ME>

# -----------------------------------------------------------------------------
# REDIS CACHE
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_INSTANCE_NAME=jnpf

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=<CHANGE_ME_TO_32+_CHARS>
JWT_ISSUER=JNPF
JWT_AUDIENCE=JNPF
JWT_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# API CONFIGURATION
# -----------------------------------------------------------------------------
# Backend API
API_HOST=0.0.0.0
API_PORT=5000
API_HTTPS_PORT=5001
API_BASE_URL=http://localhost:5000

# Swagger (disable in production)
SWAGGER_ENABLED=true
SWAGGER_ROUTE_PREFIX=swagger

# -----------------------------------------------------------------------------
# CORS CONFIGURATION
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3100,http://localhost:8100

# -----------------------------------------------------------------------------
# FRONTEND - PC ADMIN (jnpf-web-vue3)
# -----------------------------------------------------------------------------
VITE_PUBLIC_PATH=/
VITE_PORT=3100
VITE_GLOB_APP_TITLE=JNPF快速开发平台
VITE_GLOB_APP_SHORT_NAME=jnpf
VITE_GLOB_API_URL=/dev
VITE_PROXY=[["/dev","http://localhost:5000"]]
VITE_GLOB_WEBSOCKET_URL=ws://localhost:5000
VITE_GLOB_API_URL_PREFIX=
VITE_DROP_CONSOLE=false
VITE_CDN=false

# -----------------------------------------------------------------------------
# FRONTEND - DATA SCREEN (jnpf-web-datascreen)
# -----------------------------------------------------------------------------
DATAV_PORT=8100
DATAV_API_URL=http://localhost:5000

# -----------------------------------------------------------------------------
# FRONTEND - MOBILE APP (jnpf-app-vue3)
# -----------------------------------------------------------------------------
APP_API_URL=http://localhost:5000

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Serilog levels: Verbose|Debug|Information|Warning|Error|Fatal
LOG_LEVEL=Information
LOG_FILE_ENABLED=true
LOG_FILE_PATH=logs/jnpf-.log
LOG_FILE_RETAINED_DAY=30

# Slow SQL threshold (milliseconds)
SLOW_SQL_THRESHOLD_MS=1000

# -----------------------------------------------------------------------------
# FILE STORAGE
# -----------------------------------------------------------------------------
# Options: Local | AliyunOSS | MinIO
STORAGE_PROVIDER=Local
STORAGE_LOCAL_PATH=wwwroot

# Aliyun OSS (if STORAGE_PROVIDER=AliyunOSS)
# ALIYUN_OSS_ENDPOINT=
# ALIYUN_OSS_ACCESS_KEY_ID=
# ALIYUN_OSS_ACCESS_KEY_SECRET=
# ALIYUN_OSS_BUCKET_NAME=

# MinIO (if STORAGE_PROVIDER=MinIO)
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET_NAME=jnpf
# MINIO_USE_SSL=false

# -----------------------------------------------------------------------------
# EVENT BUS
# -----------------------------------------------------------------------------
# Options: Channel (in-process) | RabbitMQ
EVENT_BUS_TYPE=Channel

# RabbitMQ (if EVENT_BUS_TYPE=RabbitMQ)
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_USERNAME=guest
# RABBITMQ_PASSWORD=guest
# RABBITMQ_VIRTUAL_HOST=/

# -----------------------------------------------------------------------------
# SIGNALR / WEBSOCKET
# -----------------------------------------------------------------------------
SIGNALR_HUB_URL=/hubs
WEBSOCKET_ENABLED=true

# -----------------------------------------------------------------------------
# DOCKER SPECIFIC
# -----------------------------------------------------------------------------
# Container timezone
TZ=Asia/Shanghai

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=30

# Resource limits (for docker-compose)
API_MEMORY_LIMIT=1g
API_CPU_LIMIT=1.0
REDIS_MEMORY_LIMIT=256m
DB_MEMORY_LIMIT=2g
