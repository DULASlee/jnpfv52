{
  "env": {
    "ANTHROPIC_BASE_URL": "https://token-plan-cn.xiaomimimo.com/anthropic",
    "ANTHROPIC_AUTH_TOKEN": "tp-cu5unlnpxecv11b9h9pcln9tnscsih5irvko2fszyvo3rtg5",
    "ANTHROPIC_MODEL": "mimo-v2.5-pro",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "mimo-v2.5-pro",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "mimo-v2.5-pro",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "mimo-v2.5-pro"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read", "Write", "Edit", "MultiEdit",
      "Glob", "Grep", "WebFetch", "WebSearch",
      "NotebookEdit",
      "Skill", "Agent", "TaskCreate", "TaskUpdate", "TaskList", "TaskGet",
      "mcp__context7__*",
      "mcp__playwright__*",
      "mcp__fetch__*",
      "mcp__serena__*",
      "mcp__plugin_episodic-memory_episodic-memory__search",
      "mcp__plugin_episodic-memory_episodic-memory__read",
      "mcp__plugin_superpowers-chrome_chrome__use_browser"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Fortress v3.2 active. Rules: 1) Read .claude/memory/ 2) Plan before coding (complex tasks) 3) Fix ALL errors - never deflect 4) Verify project health before stopping 5) Save memory after session 6) Browser-test frontend changes'",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-write.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-bash.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node .claude/hooks/guard-deps.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/format-and-lint.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-finish.mjs",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node .claude/hooks/collect-summary.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
