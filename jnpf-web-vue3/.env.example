# =============================================================================
# JNPF V5.2 PC 前端 环境变量模板
# 用法：复制为 .env.development（开发）或 .env.production（生产）后修改
# 规则：.env.local / .env.*.local 已 gitignore，可放本地覆盖值
# =============================================================================

# 资源公共路径（须 / 开头结尾）
VITE_PUBLIC_PATH = /

# 端口号（仅开发环境）
VITE_PORT = 3100

# 网站标题
VITE_GLOB_APP_TITLE = JNPF快速开发平台

# 简称（配置文件名前缀，不要特殊字符）
VITE_GLOB_APP_SHORT_NAME = jnpf

# API 基础路径（开发环境走代理；生产环境改为实际地址或留空由 nginx 转发）
VITE_GLOB_API_URL = /dev

# 本地开发代理（格式 [["/前缀","http://目标"]]，多个不要换行）
VITE_PROXY = [["/dev","http://localhost:5000"]]

# WebSocket 基础地址
VITE_GLOB_WEBSOCKET_URL = ws://localhost:5000

# 接口地址前缀（统一加前缀，一般留空）
VITE_GLOB_API_URL_PREFIX =

# 是否删除 Console.log（开发 false / 生产 true）
VITE_DROP_CONSOLE = false

# 是否使用 CDN 替换本地库（内网 false / 公网按需）
VITE_CDN = false
