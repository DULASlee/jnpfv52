# =============================================================================
# .env.production 模板 — 与 web/dist_v1.1 部署产物对齐
# =============================================================================
# 用法：
#   1. 复制为 .env.production（或 merge 到现有 .env.production）
#   2. 确认 .env 中 VITE_GLOB_APP_TITLE = 智轩云
#   3. pnpm build  →  产出 dist/ + dist/_app.config.js
#   4. 部署后按需修改 dist/_app.config.js 中的 API/WS 地址（无需重新打包）
#
# 对齐依据：
#   - web/dist_v1.1/index.html          → VITE_CDN=true（bootcdn 外链 Vue 等）
#   - web/dist_v1.1/_app.config.js      → 智轩云 / jnpf / API :5000
#   - web/dist_v1.1 构建时间戳 v3.6.0-1722849008438
# =============================================================================

# 资源公共路径,需要以 / 开头和结尾
VITE_PUBLIC_PATH = /

# 是否删除 Console.log（生产包 dist 已压缩，建议 true）
VITE_DROP_CONSOLE = true

# 打包输出 gzip（dist 含 .gz 时可设为 gzip）
VITE_BUILD_COMPRESS = 'gzip'

VITE_BUILD_COMPRESS_DELETE_ORIGIN_FILE = false

# ★ 架构师裁定（2026-05-22）：DevTest/内网/F4 部署 **必须 VITE_CDN=false**
# dist_v1.1 历史产物为 true（bootcdn）；当前 bootcdn 部分版本 404，内网不可用
# 生产若要用 CDN，须配内网 CDN 镜像，不可用公网 bootcdn 默认值
VITE_CDN = false

# 打包写入 _app.config.js 的接口地址（与 dist_v1.1 一致；生产可留空由 nginx 转发，部署后改 _app.config.js）
VITE_GLOB_API_URL = http://localhost:5000

# WebSocket（与 JNPF.API.Entry 一致）
VITE_GLOB_WEBSOCKET_URL = ws://localhost:5000

VITE_GLOB_API_URL_PREFIX =

VITE_USE_IMAGEMIN = true

VITE_USE_PWA = false

VITE_LEGACY = false

# =============================================================================
# 以下变量在 .env（非 .env.production）中配置，build 时与 .env.production 合并：
#
#   VITE_GLOB_APP_TITLE = 智轩云
#   VITE_GLOB_APP_SHORT_NAME = jnpf
#
# dist_v1.1 额外定制（GitHub 镜像源码未含，补回后生效）：
#   - 路由白名单 /printDevH5 → pageEnum.ts + permissionGuard.ts
#   - views/water/* 共 9 页 → 见 docs/architecture/water-module-from-dist.md
# =============================================================================
