{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/vue-tsc/fullcheck.tsbuildinfo"
  },
  "include": ["src", "types", "vite.config.ts"],
  "exclude": [
    "node_modules",
    "tests/server/**/*.ts",
    "dist",
    "**/*.js",
    "**/*.{broken,bak,old}",
    "mock/**",
    "build/**",
    "src/core/compiler/**/templates/**",
    "src/core/compiler/**",
    "src/core/**/__tests__/**",
    "src/core/e2e/**",
    "src/views/workFlow/**",
    "src/views/onlineDev/**",
    "src/views/systemData/**",
    "src/components/VisualPortal/**",
    "src/components/PrintDesign/**",
    "src/components/FormGenerator/**",
    "src/components/FlowProcess/**",
    "src/components/FlowChart/**",
    "src/components/IntegrateProcess/**"
  ]
}
